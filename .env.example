# ============================================================
# chf-backend-test — variables d'environnement
#
# Copie ce fichier en ".env" (sans .example) et remplis les valeurs.
# Le .env n'est JAMAIS envoyé sur GitHub (il est dans .gitignore) — c'est voulu :
# ces valeurs sont des mots de passe.
#
# Où retrouver les vraies valeurs : tableau de bord Render
#   → service "chf-backend-test" → onglet "Environment"
# ============================================================


# --- OBLIGATOIRES : sans ces 3 valeurs, le serveur refuse de démarrer -------

# Supabase → Project Settings → API
# ⚠️ Prends la clé "service_role", PAS la clé "anon".
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Firebase Console → ⚙️ Paramètres du projet → Comptes de service
# → "Générer une nouvelle clé privée" → colle le JSON ENTIER sur UNE SEULE LIGNE.
FIREBASE_SERVICE_ACCOUNT=


# --- FACULTATIVES : le serveur démarre sans, avec un avertissement ---------
#     Chaque fonction concernée est simplement désactivée.

# Adresse de l'app, pour les liens de réinitialisation de mot de passe et la
# sécurité CORS. Par défaut : https://chf-app2.onrender.com
FRONTEND_URL=http://localhost:3000

# Port d'écoute local. Render le fournit tout seul en production.
PORT=3001

# Backblaze B2 — copie de la sauvegarde quotidienne hors de Supabase.
# Sans ces 3 valeurs : la sauvegarde va dans Supabase Storage, mais pas chez Backblaze.
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET_NAME=chf-sauvegarde-2026

# Resend — email de notification après la sauvegarde (jamais la sauvegarde elle-même).
RESEND_API_KEY=
EMAIL_SAUVEGARDE_DESTINATAIRE=

# CallMeBot — alertes WhatsApp (stock critique, échec de sauvegarde).
CALLMEBOT_PHONE=
CALLMEBOT_APIKEY=
